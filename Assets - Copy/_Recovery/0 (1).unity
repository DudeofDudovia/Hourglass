      m_Calls: []
  m_text: "Hourglass v0.4B\nmade by Dude of Dudovia\n\nmade using Unity\nChangelog
    V0.5A\n\tDragging add time boxes now un-adds the time.\n\tUpdated Textures\n\tFixed
    Bugs regarding Profiles\nChangelog V0.4C\n\tFIxed Bug Timer Would Be Set to a
    Value Insanely High if \n\t\tReset and the Application was Relaunched\nChangelog
    V0.4B\n\tImproved the persistence of the rich format toggle.\nChangelog V0.4A\n\tImproved
    Time Adding System\n\t\tSupport adding based on Hours and Seconds Etc:\n\t\t\t1:30:2
    would be 1 hour 30 minutes and 2 seconds.\n\tAdded Profiles\n\tUpdated UI\n\t\tChanged
    Logos\nChangelog v0.3B\n\tUpdated UI\n\t\tIt now scales numbers\n\tFixed bugs\n\t\tIt
    now saves the Default Time\nChangelog v0.3A\n\tChanged the UI\n\tAdded update
    with new Total button\n\tDid minor bug fixing\n\tAdded this menu\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9211fcdd38f50ef4c8fd7ddcb1c03d12, type: 2}
